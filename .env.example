# .env.example — 환경변수 키 목록
# 이 파일만 git에 커밋한다. 실제 값이 담긴 .env, .env.local은 절대 커밋하지 않는다.
# 실제 값은 .env.local 파일에 설정한다.

# ── Slack 알림 (scripts/notify-slack.sh) ──
# Webhook URL: Slack 앱 설정 → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
# SLACK_NOTIFY_ENABLED=false  # 선택 — false로 설정하면 알림 전체 비활성화
